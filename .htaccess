# ============================================================
#  HAZELNART — Apache settings for Namecheap cPanel hosting
#  Upload this file to public_html together with the website.
# ============================================================

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# ── One address for Google: https://hazelnart.com ───────────
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Leave SSL certificate checks alone
  RewriteCond %{REQUEST_URI} ^/\.well-known/ [NC]
  RewriteRule ^ - [L]

  # http → https and www → no-www, in a single redirect
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://hazelnart.com%{REQUEST_URI} [L,R=301]

  # /index.html → / (avoids two URLs for the home page)
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [L,R=301]
</IfModule>

# ── Security headers ─────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "frame-ancestors 'self'"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header unset X-Powered-By
</IfModule>

# Never serve hidden or helper files
<Files "send-config.php">
  Require all denied
</Files>
<FilesMatch "^(\.|README|.*\.(md|py|zip|bak|log)$)">
  Require all denied
</FilesMatch>

# ── Speed: compression ───────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

# ── Speed: browser caching ───────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 day"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

AddType video/mp4 .mp4
AddType application/xml .xml
